{
  "name": "design-system",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "lint": "turbo run lint //#lint:root",
    "lint:fix": "turbo run lint //#lint:root -- --fix",
    "lint:root": "oxlint --disable-nested-config",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "test": "turbo run test size",
    "test:packed": "turbo run test:packed",
    "test:screenshots": "turbo run test:screenshots"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@repo/oxlint-config": "workspace:*",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.12.1",
      "onFail": "download"
    }
  }
}
