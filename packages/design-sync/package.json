{
  "name": "@platform/design-sync",
  "version": "0.0.0",
  "private": true,
  "description": "Builds the claude.ai Design System artifact's project/ tree from @platform/tokens and @platform/ui. Dev-only; nothing here is published to npm.",
  "type": "module",
  "scripts": {
    "build": "node src/cli.ts build",
    "plan": "node src/cli.ts plan",
    "check-types": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run"
  },
  "devDependencies": {
    "@platform/oxlint-config": "workspace:*",
    "@platform/tokens": "workspace:*",
    "@platform/typescript-config": "workspace:*",
    "@platform/ui": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
