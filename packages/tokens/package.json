{
  "name": "@abereghici/tokens",
  "version": "0.2.0",
  "description": "Design tokens as CSS custom properties, and fonts, for the Bereghici Design System.",
  "keywords": [
    "css-custom-properties",
    "css-variables",
    "dark-mode",
    "design-system",
    "design-tokens",
    "dtcg",
    "fonts",
    "light-dark",
    "style-dictionary",
    "theming"
  ],
  "homepage": "https://github.com/abereghici/design-system/tree/main/packages/tokens#readme",
  "bugs": {
    "url": "https://github.com/abereghici/design-system/issues"
  },
  "license": "MIT",
  "author": "Alexandru Bereghici",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abereghici/design-system.git",
    "directory": "packages/tokens"
  },
  "files": [
    "dist",
    "!dist/catalog.ts",
    "fonts"
  ],
  "type": "module",
  "exports": {
    "./tokens.css": "./dist/tokens.css",
    "./components/*.css": "./dist/components/*.css",
    "./tokens.json": "./dist/tokens.json",
    "./catalog": "./dist/catalog.ts",
    "./fonts.css": "./dist/fonts.css",
    "./fonts/*": "./fonts/*",
    "./font-faces": "./src/fonts.ts",
    "./contrast-matrix": "./src/contrast-matrix.ts"
  },
  "publishConfig": {
    "exports": {
      "./tokens.css": "./dist/tokens.css",
      "./components/*.css": "./dist/components/*.css",
      "./tokens.json": "./dist/tokens.json",
      "./fonts.css": "./dist/fonts.css",
      "./fonts/*": "./fonts/*"
    },
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "check-types": "tsc",
    "fonts": "node scripts/fonts.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run"
  },
  "devDependencies": {
    "@repo/oxlint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/fontkit": "catalog:",
    "@types/node": "catalog:",
    "@types/subset-font": "catalog:",
    "fflate": "catalog:",
    "fontkit": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "style-dictionary": "catalog:",
    "subset-font": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
