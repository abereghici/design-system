{
  "name": "@platform/tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./tokens.css": "./dist/tokens.css",
    "./components/*.css": "./dist/components/*.css",
    "./tokens.json": "./dist/tokens.json",
    "./fonts.css": "./dist/fonts.css",
    "./fonts/*": "./fonts/*",
    "./contrast-matrix": "./src/contrast-matrix.ts",
    "./source/*.tokens.json": "./src/tokens/*.tokens.json"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "check-types": "tsc --noEmit",
    "fonts": "node scripts/fonts.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run"
  },
  "devDependencies": {
    "@platform/oxlint-config": "workspace:*",
    "@platform/typescript-config": "workspace:*",
    "@types/fontkit": "catalog:",
    "@types/node": "catalog:",
    "@types/subset-font": "catalog:",
    "fflate": "catalog:",
    "fontkit": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "style-dictionary": "catalog:",
    "subset-font": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
