      "$value": "{semantic.space-inset-md}"
    },
    "accordion-trigger-font": {
      "$type": "typography",
      "$value": "{semantic.type-label-md}"
    },
    "accordion-trigger-text-color": {
      "$type": "color",
      "$value": "{semantic.color-text-default}"
    },
    "accordion-trigger-icon-color": {
      "$type": "color",
      "$value": "{semantic.color-icon-subtle}"
    },
    "accordion-trigger-icon-color-hovered": {
