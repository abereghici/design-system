{
  "component": {
    "drop-zone-padding": {
      "$type": "dimension",
      "$value": "{semantic.space-inset-xl}"
    },
    "drop-zone-gap": {
      "$type": "dimension",
      "$value": "{semantic.space-stack-sm}"
    },
    "drop-zone-border-radius": {
      "$type": "dimension",
      "$value": "{semantic.radius-lg}"
    },
    "drop-zone-border-width": {
      "$type": "dimension",
      "$value": "{semantic.border-width-default}"
    },
    "drop-zone-font": {
      "$type": "typography",
      "$value": "{semantic.type-body-sm}"
    },
    "drop-zone-text-color": {
      "$type": "color",
      "$value": "{semantic.color-text-subtle}"
    },
    "drop-zone-background-color": {
      "$type": "color",
      "$value": "{semantic.color-surface-raised}"
    },
    "drop-zone-border-color": {
      "$type": "color",
      "$value": "{semantic.color-border-default}"
    },
    "drop-zone-background-color-hovered": {
      "$type": "color",
      "$value": "{semantic.color-background-accent-subtle}"
    },
    "drop-zone-border-color-hovered": {
      "$type": "color",
      "$value": "{semantic.color-border-accent}"
    },
    "drop-zone-border-color-invalid": {
      "$type": "color",
      "$value": "{semantic.color-border-danger}"
    }
  }
}
