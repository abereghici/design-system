{
  "component": {
    "checkbox-size": {
      "$type": "dimension",
      "$value": "{semantic.size-icon-sm}"
    },
    "checkbox-border-radius": {
      "$type": "dimension",
      "$value": "{semantic.radius-xs}"
    },
    "checkbox-border-width": {
      "$type": "dimension",
      "$value": "{semantic.border-width-default}"
    },
    "checkbox-gap": {
      "$type": "dimension",
      "$value": "{semantic.space-inline-sm}"
    },
    "checkbox-label-font": {
      "$type": "typography",
      "$value": "{semantic.type-label-sm}"
    },
    "checkbox-background-color": {
      "$type": "color",
      "$value": "{semantic.color-surface-overlay}"
    },
    "checkbox-border-color": {
      "$type": "color",
      "$value": "{semantic.color-border-default}"
    },
    "checkbox-border-color-hovered": {
      "$type": "color",
      "$value": "{semantic.color-border-default-hovered}"
    },
    "checkbox-background-color-checked": {
      "$type": "color",
      "$value": "{semantic.color-background-accent-bold}"
    },
    "checkbox-icon-color-checked": {
      "$type": "color",
      "$value": "{semantic.color-icon-on-accent}"
    },
    "checkbox-scale-pressed": {
      "$type": "number",
      "$value": "{semantic.motion-scale-pressed}"
    },
    "checkbox-duration": {
      "$type": "duration",
      "$value": "{semantic.motion-duration-toggle}"
    },
    "checkbox-border-color-invalid": {
      "$type": "color",
      "$value": "{semantic.color-border-danger}"
    }
  }
}
