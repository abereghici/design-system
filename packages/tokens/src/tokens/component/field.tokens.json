      "$value": "{semantic.space-stack-xs}"
    },
    "field-label-font": {
      "$type": "typography",
      "$value": "{semantic.type-label-sm}"
    },
    "field-helper-font": {
      "$type": "typography",
      "$value": "{semantic.type-body-xs}"
    },
    "field-label-text-color": {
      "$type": "color",
      "$value": "{semantic.color-text-default}"
    },
    "field-helper-text-color": {
      "$type": "color",
      "$value": "{semantic.color-text-subtle}"
    },
    "field-error-text-color": {
      "$type": "color",
      "$value": "{semantic.color-text-danger}"
    }
  }
}
