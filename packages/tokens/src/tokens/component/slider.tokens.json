{
  "component": {
    "slider-height": {
      "$type": "dimension",
      "$value": "{semantic.size-control-xs}"
    },
    "slider-track-height": {
      "$type": "dimension",
      "$value": "{semantic.size-indicator}"
    },
    "slider-track-border-radius": {
      "$type": "dimension",
      "$value": "{semantic.radius-full}"
    },
    "slider-track-background-color": {
      "$type": "color",
      "$value": "{semantic.color-border-default}"
    },
    "slider-range-background-color": {
      "$type": "color",
      "$value": "{semantic.color-background-accent-bold}"
    },
    "slider-thumb-size": {
      "$type": "dimension",
      "$value": "{semantic.size-icon-sm}"
    },
    "slider-thumb-border-width": {
      "$type": "dimension",
      "$value": "{semantic.border-width-thick}"
    },
    "slider-thumb-background-color": {
      "$type": "color",
      "$value": "{semantic.color-surface-overlay}"
    },
    "slider-thumb-border-color": {
      "$type": "color",
      "$value": "{semantic.color-border-accent}"
    },
    "slider-thumb-shadow": {
      "$type": "shadow",
      "$value": "{semantic.elevation-raised}"
    },
    "slider-value-font": {
      "$type": "typography",
      "$value": "{semantic.type-data-sm}"
    },
    "slider-value-font-variant-numeric": {
      "$type": "string",
      "$value": "{semantic.type-data-sm-font-variant-numeric}"
    },
    "slider-value-text-color": {
      "$type": "color",
      "$value": "{semantic.color-text-subtle}"
    }
