    "alert-title-font": {
      "$type": "typography",
      "$value": "{semantic.type-label-md}"
    },
    "alert-title-text-color": {
      "$type": "color",
      "$value": "{semantic.color-text-default}"
    },
    "alert-description-font": {
      "$type": "typography",
