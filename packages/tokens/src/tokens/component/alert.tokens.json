{
  "component": {
    "alert-padding": {
      "$type": "dimension",
      "$value": "{semantic.space-inset-md}"
    },
    "alert-gap": {
      "$type": "dimension",
      "$value": "{semantic.space-inline-md}"
    },
    "alert-body-gap": {
      "$type": "dimension",
      "$value": "{semantic.space-stack-xs}"
    },
    "alert-border-radius": {
      "$type": "dimension",
      "$value": "{semantic.radius-lg}"
    },
    "alert-icon-size": {
      "$type": "dimension",
      "$value": "{semantic.size-icon-sm}"
