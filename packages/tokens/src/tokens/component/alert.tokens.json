    },
    "alert-success-icon-color": {
      "$type": "color",
      "$value": "{semantic.color-icon-success}"
    },
    "alert-warning-icon-color": {
      "$type": "color",
      "$value": "{semantic.color-icon-warning}"
    },
    "alert-danger-icon-color": {
      "$type": "color",
      "$value": "{semantic.color-icon-danger}"
