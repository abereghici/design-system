    "timeline-gap": {
      "$type": "dimension",
      "$value": "{semantic.space-inline-md}"
    },
    "timeline-item-gap": {
      "$type": "dimension",
      "$value": "{semantic.space-stack-lg}"
    },
    "timeline-indicator-size": {
      "$type": "dimension",
      "$value": "{semantic.size-icon-xs}"
    },
    "timeline-indicator-border-radius": {
      "$type": "dimension",
      "$value": "{semantic.radius-full}"
    },
    "timeline-indicator-border-width": {
      "$type": "dimension",
      "$value": "{semantic.border-width-thick}"
    },
