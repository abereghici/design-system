{
  "name": "@abereghici/ui",
  "version": "0.1.1",
  "description": "React components for the Bereghici Design System.",
  "keywords": [
    "accessibility",
    "anchor-positioning",
    "component-library",
    "dark-mode",
    "design-system",
    "nextjs",
    "popover-api",
    "react",
    "react-components",
    "react-server-components",
    "ui-components"
  ],
  "homepage": "https://ui.bereghici.dev",
  "bugs": {
    "url": "https://github.com/abereghici/design-system/issues"
  },
  "license": "MIT",
  "author": "Alexandru Bereghici",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abereghici/design-system.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "imports": {
    "#.storybook/*": "./.storybook/*"
  },
  "exports": {
    "./*": "./src/*/index.ts",
    "./internal/*": null,
    "./icons/*": "./src/icon/icons/*.tsx"
  },
  "publishConfig": {
    "exports": {
      "./*": {
        "types": "./dist/*/index.d.ts",
        "default": "./dist/*/index.js"
      },
      "./internal/*": null,
      "./icons/*": {
        "types": "./dist/icon/icons/*.d.ts",
        "default": "./dist/icon/icons/*.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "storybook": "storybook dev --port 6006",
    "build-storybook": "storybook build",
    "check-types": "tsc && tsc -p scripts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "size": "size-limit",
    "test": "vitest run --project \"!screenshot:*\"",
    "test:watch": "vitest --project \"!screenshot:*\"",
    "icons": "node scripts/icons.ts",
    "test:screenshots": "vitest run --project \"screenshot:*\" --reporter=default --reporter=html",
    "test:screenshots:docker": "sh scripts/screenshots-docker.sh"
  },
  "dependencies": {
    "@abereghici/tokens": "workspace:^",
    "temporal-polyfill": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@repo/oxlint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@rolldown/plugin-babel": "catalog:",
    "@size-limit/esbuild": "catalog:",
    "@size-limit/file": "catalog:",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-mcp": "catalog:",
    "@storybook/addon-vitest": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@tsdown/css": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "remark-gfm": "catalog:",
    "rolldown": "catalog:",
    "size-limit": "catalog:",
    "storybook": "catalog:",
    "svgo": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
