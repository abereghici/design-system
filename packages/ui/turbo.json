{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "check-types": {
      "dependsOn": ["$TURBO_EXTENDS$", "^build"]
    },
    "lint": {
      "dependsOn": ["$TURBO_EXTENDS$", "^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "size": {
      "dependsOn": ["^build"]
    },
    "test:screenshots": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
