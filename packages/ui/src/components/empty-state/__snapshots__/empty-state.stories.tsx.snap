// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Default   > base story 1`] = `
- heading "No files yet" [level=3]
- paragraph: Upload a file or create one to get started.
- button "New file"
`;

exports[`In A Table   > base story 1`] = `
- table "Files":
  - caption: Files
  - rowgroup:
    - row "Name Owner Modified":
      - columnheader "Name"
      - columnheader "Owner"
      - columnheader "Modified"
  - rowgroup:
    - row "No files yet Upload a file or create one to get started. New file":
      - cell "No files yet Upload a file or create one to get started. New file":
        - heading "No files yet" [level=3]
        - paragraph: Upload a file or create one to get started.
        - button "New file"
`;

exports[`Worst Case 1`] = `
- heading "Aucun document partagé avec Northwind Industries Holdings pour le moment" [level=3]
- paragraph: Importez un fichier ou demandez à bartholomew.fitzgerald@northwind-industries-holdings.example.com de vous en partager un.
- button "Importer des documents depuis votre ordinateur"
`;
