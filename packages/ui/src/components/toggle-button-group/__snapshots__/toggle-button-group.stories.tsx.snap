// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Default   > base story 1`] = `
- group "Text style":
  - button "Bold" [pressed]
  - button "Italic"
  - button "Underline"
`;

exports[`In A Toolbar   > base story 1`] = `
- toolbar "Formatting":
  - group "Text style":
    - button "Bold" [pressed]
    - button "Italic"
    - button "Underline"
`;

exports[`Single Selection   > base story 1`] = `
- group "Alignment":
  - button "Start" [pressed]
  - button "Center"
  - button "End"
`;

exports[`Worst Case 1`] = `
- group "Text style":
  - button "Gras"
  - button "Italique"
  - button "Souligné"
  - button "Durchgestrichen"
`;
