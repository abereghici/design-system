// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Default   > base story 1`] = `
- status
- alert
`;

exports[`Stacked   > base story 1`] = `
- button "Save"
- status:
  - paragraph: Done
  - paragraph: Uploaded 3 files
  - paragraph: Uploaded 2 files
  - paragraph: Uploaded 1 file
- alert
- region "Notifications":
  - list:
    - listitem:
      - text: Done
      - button "Dismiss"
    - listitem:
      - text: Uploaded 3 files
      - button "Dismiss"
    - listitem:
      - text: Uploaded 2 files
      - button "Dismiss"
    - listitem:
      - text: Uploaded 1 file
      - button "Dismiss"
`;

exports[`Worst Case 1`] = `
- status:
  - paragraph: ✓
  - paragraph: Impossible d’inviter bartholomew.fitzgerald@northwind-industries-holdings.example.com L’espace de travail a atteint sa limite de 1 284 membres.
  - paragraph: Jo a rejoint l’espace de travail
- alert
- region "Notifications":
  - list:
    - listitem:
      - text: ✓
      - button "Dismiss"
    - listitem:
      - text: Impossible d’inviter bartholomew.fitzgerald@northwind-industries-holdings.example.com L’espace de travail a atteint sa limite de 1 284 membres.
      - button "Dismiss"
    - listitem:
      - text: Jo a rejoint l’espace de travail
      - button "Dismiss"
`;
