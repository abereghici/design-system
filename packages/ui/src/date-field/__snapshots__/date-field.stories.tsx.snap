// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Default   > base story 1`] = `
- text: Date of birth
- group "Date of birth":
  - spinbutton "month"
  - spinbutton "day"
  - spinbutton "year"
`;

exports[`Editing 1`] = `
- text: Date of birth
- group "Date of birth":
  - spinbutton "month": "04"
  - spinbutton "day"
  - spinbutton "year"
`;

exports[`In A Form   > base story 1`] = `
- form "Profile":
  - text: Date of birth *" / "
  - group "Date of birth *\\" / \\"":
    - spinbutton "month"
    - spinbutton "day"
    - spinbutton "year"
  - button "Save"
`;
