{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["$TURBO_EXTENDS$", "check-types"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "test:packed": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:screenshots": {
      "dependsOn": ["build"],
      "passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH"],
      "cache": false
    }
  }
}
