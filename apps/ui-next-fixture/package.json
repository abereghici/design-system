{
  "name": "@repo/ui-next-fixture",
  "version": "0.0.0",
  "private": true,
  "description": "Next 16 app that consumes @abereghici/ui as source, and as the packed npm packages in test:packed, and checks its subpath exports, tree-shaking and React Compiler output.",
  "files": [
    "src",
    "test",
    "next.config.ts",
    "vitest.config.ts"
  ],
  "type": "module",
  "scripts": {
    "build": "next build",
    "check-types": "next typegen && tsc",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run && playwright test --grep-invert @screenshot",
    "test:packed": "node scripts/test-packed.ts",
    "test:screenshots": "playwright test --grep @screenshot"
  },
  "dependencies": {
    "@abereghici/tokens": "workspace:*",
    "@abereghici/ui": "workspace:*",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "temporal-polyfill": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@playwright/test": "catalog:",
    "@repo/oxlint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@total-typescript/ts-reset": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "browserslist": [
    "baseline newly available"
  ]
}
