{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**", "out/**"]
    },
    "build-storybook": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    },
    "check-types": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "size": {
      "dependsOn": ["^build"]
    },
    "test:packed": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:screenshots": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH"],
      "cache": false
    },
    "//#lint:root": {}
  }
}
